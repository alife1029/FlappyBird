{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Make",
			"type": "shell",
			"command": "make",
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"args": [
				"-j8"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"dependsOn": [
				"CMake"
			]
		},
		{
			"label": "CMake",
			"type": "shell",
			"command": "cmake",
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"args": [
				"${workspaceFolder}"
			],
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"dependsOn": [
				"Create Build Directory"
			]
		},
		{
			"label": "Create Build Directory",
			"type": "shell",
			"command": "mkdir",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"args": [
				"-p",
				"build"
			]
		}
	]
}